{
  "apps/api/**/*.{ts,js}": [
    "npm exec --workspace apps/api -- eslint --fix",
    "npm exec --workspace apps/api -- prettier --write"
  ],
  "apps/web/**/*.{ts,js,html,scss,css}": [
    "npm exec --workspace apps/api -- prettier --write"
  ],
  "*.{json,md,mjs,yml}": [
    "npm exec --workspace apps/api -- prettier --write"
  ]
}
